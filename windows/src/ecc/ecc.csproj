<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0: list/info on any OS (used to compare with the Swift CLI on macOS), subtitles from a WAV mix.
       net10.0-windows: adds `render` (Media Foundation, Direct2D, DirectWrite) and subtitles from the timeline. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnhanceCapCut.Draft\EnhanceCapCut.Draft.csproj" />
    <ProjectReference Include="..\EnhanceCapCut.Subtitles\EnhanceCapCut.Subtitles.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\EnhanceCapCut.Windows\EnhanceCapCut.Windows.csproj" />
  </ItemGroup>

</Project>
