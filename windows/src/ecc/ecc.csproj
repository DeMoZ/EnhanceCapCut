<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0: list/info on any OS (used to compare with the Swift CLI on macOS), subtitles from a WAV mix.
       net10.0-windows10.0.19041.0: adds `render` (Media Foundation, Direct2D, DirectWrite), subtitles from the timeline and voice-over. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnhanceCapCut.Draft\EnhanceCapCut.Draft.csproj" />
    <ProjectReference Include="..\EnhanceCapCut.Subtitles\EnhanceCapCut.Subtitles.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ApplicationIcon>..\EnhanceCapCut.App\EnhanceCapCut.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <ProjectReference Include="..\EnhanceCapCut.Windows\EnhanceCapCut.Windows.csproj" />
  </ItemGroup>

</Project>
