<Project Sdk="Microsoft.NET.Sdk">

  <!-- Speech recognition (Whisper through whisper.cpp) and translation (NLLB-200 in ONNX Runtime), offline.
       Platform-neutral: runs on Windows and, for checking against the macOS version, on macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- GPU recognition on Windows; Whisper.net falls back to the CPU runtime without a Vulkan driver. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnhanceCapCut.Draft\EnhanceCapCut.Draft.csproj" />
  </ItemGroup>

</Project>
